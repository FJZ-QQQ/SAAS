# ============================================
# 橙子AI客服系统 - 环境变量配置
# 请将此文件复制为 .env 并填入真实值
# ============================================

# ---- JWT 密钥 ----
JWT_SECRET=your-super-secret-key-change-me-in-production

# ---- 抖音开放平台配置 ----
DOUYIN_CLIENT_KEY=your_douyin_client_key
DOUYIN_CLIENT_SECRET=your_douyin_client_secret
DOUYIN_PLATFORM_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_PUBLIC_KEY_HERE\n-----END PUBLIC KEY-----"

# 你的系统公网域名
APP_BASE_URL=http://localhost:3000

# ---- 扣子(Coze) AI平台配置 ----
COZE_API_KEY=your_coze_api_key
COZE_BOT_ID=your_coze_bot_id

# ---- 管理员后台 ----
ADMIN_ACCOUNT=admin
ADMIN_PASSWORD=admin123

# ---- 支付宝配置 (当面付/扫码支付) ----
# 在 https://open.alipay.com 创建应用后获取
ALIPAY_APP_ID=your_alipay_app_id
ALIPAY_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END RSA PRIVATE KEY-----"
ALIPAY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nALIPAY_PUBLIC_KEY_HERE\n-----END PUBLIC KEY-----"

# ---- 微信支付配置 (Native支付/扫码支付) ----
# 在 https://pay.weixin.qq.com 商户平台获取
WECHAT_MCH_ID=your_merchant_id
WECHAT_APP_ID=your_wechat_app_id
WECHAT_API_KEY_V3=your_api_v3_key
WECHAT_SERIAL_NO=your_certificate_serial_no
WECHAT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"
